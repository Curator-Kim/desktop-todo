{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面待办",
  "version": "0.1.4",
  "identifier": "com.desktop.todo.sticky",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌面待办",
        "width": 380,
        "height": 520,
        "minWidth": 300,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      },
      {
        "label": "settings",
        "title": "桌面待办 - 设置",
        "url": "/?view=settings",
        "width": 540,
        "height": 720,
        "minWidth": 440,
        "minHeight": 520,
        "decorations": true,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
